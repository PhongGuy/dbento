<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Dbento third-party notices</title>
<style>
body { font-family: sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; }
</style>
</head>
<body>
<h1>Third-party notices</h1>
<p>Dbento includes the following open-source crates, grouped by licence.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
<ul>
{{#each licenses}}
<li>
<h3 id="{{id}}">{{name}}</h3>
<h4>Used by</h4>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</li>
{{/each}}
</ul>
</body>
</html>
